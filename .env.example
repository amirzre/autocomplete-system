# Application Configuration
APP_NAME="Autocomplete System"
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=info
DEFAULT_SUGGESTIONS=5
MAX_SUGGESTIONS_LIMIT=20

# Server Configuration
SERVER_HOST=localhost
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=autocomplete_db
QUERY_COLLECTION=queries
MONGO_USERNAME=root
MONGO_PASSWORD=pass
MONGO_AUTH_DB=admin
DB_CONNECT_TIMEOUT=10s
DB_QUERY_TIMEOUT=5s

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=3
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_TTL=1h
REDIS_MAX_SIZE=10000

# Worker Configuration
WORKER_AGGREGATION_INTERVAL=1m
WORKER_BATCH_SIZE=100
WORKER_ENABLED=true
